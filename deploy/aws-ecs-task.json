{
  "family": "agentic-honeypot-task",
  "networkMode": "awsvpc",
  "containerDefinitions": [
    {
      "name": "agentic-honeypot-container",
      "image": "123456789012.dkr.ecr.us-east-1.amazonaws.com/agentic-honeypot:latest",
      "essential": true,
      "portMappings": [
        {
          "containerPort": 8000,
          "hostPort": 8000,
          "protocol": "tcp"
        }
      ],
      "environment": [
        { "name": "PORT", "value": "8000" }
      ]
    }
  ],
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "512",
  "memory": "1024"
}
